# Copy this file to .env and fill in real values for local `vercel dev`
# testing. Never commit the real .env — add these same values in the
# Vercel dashboard under Project Settings -> Environment Variables for
# production/preview deployments.

# SMTP transport — works with Gmail (use an "App Password", not your normal
# password: https://myaccount.google.com/apppasswords) or any SMTP provider
# (SendGrid, Mailgun, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-app-password

# Where contact-form submissions get delivered
ADMIN_EMAIL=muthumonishaelango4@gmail.com
